# ============================================================
# Runtime database
# ============================================================

# Neon PostgreSQL pooled connection.
# Digunakan oleh aplikasi Next.js saat runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/gkj_slogohimo?sslmode=require"

# ============================================================
# Prisma CLI / migrations
# ============================================================

# Neon PostgreSQL direct connection.
# Digunakan Prisma CLI, termasuk `prisma migrate deploy`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/gkj_slogohimo?sslmode=require"

# ============================================================
# Authentication
# ============================================================

# iron-session secret — minimum 32 characters.
# Gunakan random secret yang berbeda untuk production.
SESSION_PASSWORD="replace-with-a-secure-random-secret"

# Token untuk alamat login pengelola. Minimum 24 karakter, hanya huruf/angka/_/-.
# Contoh URL: /pengelola/<ADMIN_LOGIN_TOKEN>
# Generate dengan: openssl rand -hex 16
ADMIN_LOGIN_TOKEN="replace-with-a-random-admin-login-token"

# ============================================================
# Public website
# ============================================================

# Development:
SITE_URL="http://localhost:3000"

# Production harus diganti dengan origin HTTPS resmi, contoh:
# SITE_URL="https://gkj-slogohimo.example"

# ============================================================
# Initial Super Admin
# ============================================================

# Hanya digunakan oleh `pnpm db:seed`.
# Tidak diperlukan oleh runtime aplikasi setelah proses seed selesai.
SUPER_ADMIN_NAME="GKJ Slogohimo Administrator"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"