generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTRIBUTOR
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(CONTRIBUTOR)
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pawartos      Pawartos[]
  news          News[]
  agendas       Agenda[]
  announcements Announcement[]
  sitePages     SitePage[]

  @@index([role])
  @@index([isActive])
}

model LoginRateLimit {
  key String @id

  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?

  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
}

enum ChurchLocationType {
  CHURCH
  PEPANTHAN
}

model ChurchLocation {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  googleMapsUrl   String?
  type            ChurchLocationType
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  worshipServices WorshipService[]

  @@index([type])
  @@index([isActive, sortOrder])
}

model WorshipServiceRole {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments WorshipServiceAssignment[]
}

model WorshipSchedule {
  id          String    @id @default(cuid())
  date        DateTime  @unique @db.Date
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services WorshipService[]
}

model WorshipService {
  id                String   @id @default(cuid())
  worshipScheduleId String
  churchLocationId  String
  name              String
  startsAt          DateTime
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worshipSchedule WorshipSchedule @relation(fields: [worshipScheduleId], references: [id], onDelete: Cascade)

  assignments WorshipServiceAssignment[]

  churchLocation ChurchLocation @relation(fields: [churchLocationId], references: [id], onDelete: Restrict)

  @@unique([worshipScheduleId, churchLocationId, startsAt])
  @@index([worshipScheduleId, sortOrder])
  @@index([churchLocationId])
  @@index([startsAt])
}

model WorshipServiceAssignment {
  id                   String   @id @default(cuid())
  worshipServiceId     String
  worshipServiceRoleId String
  personName           String
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  worshipService     WorshipService     @relation(fields: [worshipServiceId], references: [id], onDelete: Cascade)
  worshipServiceRole WorshipServiceRole @relation(fields: [worshipServiceRoleId], references: [id], onDelete: Restrict)

  @@index([worshipServiceId, sortOrder])
  @@index([worshipServiceRoleId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model BibleStudySchedule {
  id         String    @id @default(cuid())
  groupName  String
  dayOfWeek  DayOfWeek
  startTime  String
  location   String?
  leaderName String?
  notes      String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([dayOfWeek, sortOrder])
  @@index([isActive])
}

model ChurchMinistry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  summary     String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model ChurchPastor {
  id          String    @id @default(cuid())
  fullName    String
  slug        String    @unique
  periodStart DateTime  @db.Date
  periodEnd   DateTime? @db.Date
  summary     String?
  biography   String?
  photoUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([periodStart])
  @@index([periodEnd])
  @@index([isActive])
}

model ChurchCouncilMember {
  id          String    @id @default(cuid())
  fullName    String
  position    String
  periodStart DateTime  @db.Date
  periodEnd   DateTime? @db.Date
  photoUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
  @@index([isActive])
  @@index([periodStart])
  @@index([periodEnd])
}

model ChurchStatisticSnapshot {
  id        String   @id @default(cuid())
  title     String
  asOfDate  DateTime @unique @db.Date
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics ChurchStatisticMetric[]

  @@index([asOfDate])
  @@index([isActive])
}

model ChurchStatisticMetric {
  id         String   @id @default(cuid())
  snapshotId String
  category   String
  label      String
  value      Int
  unit       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshot ChurchStatisticSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([snapshotId, sortOrder])
  @@index([isActive])
}

model GalleryAlbum {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String?
  eventDate      DateTime? @db.Date
  coverImageUrl  String?
  googleDriveUrl String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  images GalleryImage[]

  @@index([sortOrder])
  @@index([isActive])
  @@index([eventDate])
}

model GalleryImage {
  id        String   @id @default(cuid())
  albumId   String
  imageUrl  String
  caption   String?
  altText   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Restrict)

  @@unique([albumId, imageUrl])
  @@index([albumId, sortOrder])
  @@index([albumId, isActive, sortOrder])
  @@index([isActive])
}

model ChurchForm {
  id            String   @id @default(cuid())
  title         String
  description   String?
  googleFormUrl String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model WebsiteSetting {
  id String @id @default("main")

  siteName    String
  tagline     String?
  description String?

  email    String?
  phone    String?
  whatsapp String?

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PawartosStatus {
  DRAFT
  PUBLISHED
}

model Pawartos {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  publicationDate   DateTime @db.Date
  description       String?
  googleDriveUrl    String
  googleDriveFileId String   @unique

  status      PawartosStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicationDate])
  @@index([status, publicationDate])
  @@index([authorId])
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model News {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content Json

  coverImageUrl    String?
  coverImageFileId String?

  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  images NewsImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model NewsImage {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  googleDriveUrl    String
  googleDriveFileId String

  altText   String?
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([newsId, googleDriveFileId])
  @@index([newsId, sortOrder])
}

enum AgendaStatus {
  DRAFT
  PUBLISHED
}

model Agenda {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content Json

  startsAt DateTime
  endsAt   DateTime?

  location      String?
  googleMapsUrl String?

  coverImageUrl    String?
  coverImageFileId String?

  status      AgendaStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([startsAt])
  @@index([authorId])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model Announcement {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  content Json

  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

model SitePage {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  content Json

  status      SitePageStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}
