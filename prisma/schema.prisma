generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTRIBUTOR
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(CONTRIBUTOR)
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(1)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model LoginRateLimit {
  key String @id

  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?

  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
}

enum ChurchLocationType {
  CHURCH
  PEPANTHAN
}

model ChurchLocation {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  googleMapsUrl   String?
  type            ChurchLocationType
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  worshipServices WorshipService[]

  @@index([type])
  @@index([isActive, sortOrder])
}

model WorshipServiceRole {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments WorshipServiceAssignment[]
}

model WorshipSchedule {
  id          String    @id @default(cuid())
  date        DateTime  @unique @db.Date
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services WorshipService[]
}

model WorshipService {
  id                String   @id @default(cuid())
  worshipScheduleId String
  churchLocationId  String
  name              String
  startsAt          DateTime
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worshipSchedule WorshipSchedule @relation(fields: [worshipScheduleId], references: [id], onDelete: Cascade)

  assignments WorshipServiceAssignment[]

  churchLocation ChurchLocation @relation(fields: [churchLocationId], references: [id], onDelete: Restrict)

  @@unique([worshipScheduleId, churchLocationId, startsAt])
  @@index([worshipScheduleId, sortOrder])
  @@index([churchLocationId])
  @@index([startsAt])
}

model WorshipServiceAssignment {
  id                   String   @id @default(cuid())
  worshipServiceId     String
  worshipServiceRoleId String
  personName           String
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  worshipService     WorshipService     @relation(fields: [worshipServiceId], references: [id], onDelete: Cascade)
  worshipServiceRole WorshipServiceRole @relation(fields: [worshipServiceRoleId], references: [id], onDelete: Restrict)

  @@index([worshipServiceId, sortOrder])
  @@index([worshipServiceRoleId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model BibleStudySchedule {
  id         String    @id @default(cuid())
  groupName  String
  dayOfWeek  DayOfWeek
  startTime  String
  location   String?
  leaderName String?
  notes      String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([dayOfWeek, sortOrder])
  @@index([isActive])
}

model ChurchMinistry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  summary     String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model ChurchPastor {
  id          String    @id @default(cuid())
  fullName    String
  slug        String    @unique
  periodStart DateTime  @db.Date
  periodEnd   DateTime? @db.Date
  summary     String?
  biography   String?
  photoUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([periodStart])
  @@index([periodEnd])
  @@index([isActive])
}

model ChurchCouncilMember {
  id          String    @id @default(cuid())
  fullName    String
  position    String
  periodStart DateTime  @db.Date
  periodEnd   DateTime? @db.Date
  photoUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
  @@index([isActive])
  @@index([periodStart])
  @@index([periodEnd])
}
